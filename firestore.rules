rules_version = '2';
// Règles de sécurité Firestore pour Cavalier : à coller dans la console Firebase (Firestore Database > Règles)
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil public : pseudo et Elo, lisibles par les joueurs connectés, modifiables par leur seul propriétaire
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Progression : visible et modifiable uniquement par son propriétaire
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Pseudos uniques : chaque pseudo pointe vers un seul compte
    match /pseudos/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // Invitations : visibles par l'expéditeur et le destinataire
    match /invites/{id} {
      allow read, delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow update: if false;
    }
    // Parties : lisibles et jouables seulement par leurs deux joueurs
    match /games/{id} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.players;
      // une partie de tournoi peut être créée par n'importe quel membre du tournoi (ronde suivante)
      allow create: if request.auth != null && (request.auth.uid in request.resource.data.players
        || (request.resource.data.tournamentId is string && request.auth.uid in get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.members));
      allow delete: if false;
    }
    // Tournois : visibles par les joueurs connectés ; créés par leur organisateur ; mis à jour par les inscrits
    match /tournaments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
