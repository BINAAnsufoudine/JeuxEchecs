rules_version = '2';
// Règles de sécurité Firestore pour Cavalier : à coller dans la console Firebase (Firestore Database > Règles)
service cloud.firestore {
  match /databases/{database}/documents {
    // Compte administrateur : l'adresse enregistrée dans config/admin (au départ celle du développeur),
    // une fois vérifiée par e-mail. L'administrateur peut transmettre ce rôle à une autre adresse.
    function adminEmail() {
      return exists(/databases/$(database)/documents/config/admin)
        ? get(/databases/$(database)/documents/config/admin).data.email
        : 'ansuf.dev@gmail.com';
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == adminEmail();
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // Anti-triche : l'Elo et le grade sont calculés sur l'appareil du joueur ; on borne leurs valeurs
    // et ce qu'une seule écriture peut changer (une partie fait bouger l'Elo de quelques dizaines de points,
    // le grade de 45 points au plus en victoire et de 30 au plus en défaite).
    function changed(key) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
    }
    function eloOk() {
      return !changed('elo') || (request.resource.data.elo is number
        && request.resource.data.elo >= 100 && request.resource.data.elo <= 3200
        && math.abs(request.resource.data.elo - resource.data.get('elo', 600)) <= 400);
    }
    function gradeOk() {
      return !changed('gradePts') || (request.resource.data.gradePts is number
        && request.resource.data.gradePts >= 0 && request.resource.data.gradePts <= 5000
        && request.resource.data.gradePts - resource.data.get('gradePts', 0) <= 45
        && resource.data.get('gradePts', 0) - request.resource.data.gradePts <= 30);
    }
    function validPseudo(pseudo, pseudoLower) {
      return pseudo is string && pseudo.size() >= 1 && pseudo.size() <= 24
        && pseudoLower is string && pseudoLower == pseudo.lower();
    }
    function validMoveUpdate() {
      return !changed('moves') || (
        resource.data.status == 'active'
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == resource.data.moves.size() + 1
        && request.resource.data.moves == resource.data.moves.concat([request.resource.data.moves[resource.data.moves.size()]])
        && request.resource.data.moves[resource.data.moves.size()] is string
        && request.resource.data.moves[resource.data.moves.size()].matches('^[a-h][1-8][a-h][1-8][qrbn]?$')
        && request.auth.uid == (resource.data.moves.size() % 2 == 0 ? resource.data.white : resource.data.black)
      ) || (
        changed('moves')
        && resource.data.status == 'active'
        && resource.data.get('takeback', null) is map
        && resource.data.takeback.by != request.auth.uid
        && request.resource.data.get('takeback', null) == null
        && request.resource.data.get('takebackAnswer', null) is map
        && request.resource.data.takebackAnswer.by == request.auth.uid
        && request.resource.data.takebackAnswer.ok == true
        && request.resource.data.moves is list
        && request.resource.data.moves.size() < resource.data.moves.size()
        && resource.data.moves.size() - request.resource.data.moves.size() <= 2
      );
    }
    match /config/admin {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && request.resource.data.email is string && request.resource.data.email == request.resource.data.email.lower();
    }
    // Profil public : pseudo et Elo, lisibles par les joueurs connectés, modifiables par leur seul propriétaire
    match /users/{uid} {
      allow read: if request.auth != null;
      // un joueur ne peut pas lever lui-même sa suspension (champ « banned »)
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pseudo', 'pseudoLower', 'elo', 'createdAt'])
        && validPseudo(request.resource.data.pseudo, request.resource.data.pseudoLower)
        && request.resource.data.elo is number && request.resource.data.elo >= 100 && request.resource.data.elo <= 3200;
      // Les champs publics sont modifiables par leur propriétaire, jamais les rôles ou sanctions.
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && changedOnly(['pseudo', 'pseudoLower', 'elo', 'summary', 'summaryAt', 'gradePts', 'photo', 'muted', 'lastSeen', 'admin'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin']) || request.resource.data.get('admin', false) == false)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pseudo', 'pseudoLower'])
          || validPseudo(request.resource.data.get('pseudo', ''), request.resource.data.get('pseudoLower', '')))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photo'])
          || request.resource.data.get('photo', null) == null
          || (request.resource.data.photo is string && request.resource.data.photo.size() <= 200000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['muted'])
          || (request.resource.data.muted is list && request.resource.data.muted.size() <= 200))
        && eloOk() && gradeOk());
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      // Progression : visible et modifiable uniquement par son propriétaire (l'admin peut l'effacer)
      match /private/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'device'])
          && request.resource.data.json is string && request.resource.data.json.size() < 900000
          && request.resource.data.updatedAt is number
          && (request.resource.data.device == null || (request.resource.data.device is string && request.resource.data.device.size() <= 80));
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }
    // Défi du jour : un résultat par joueur et par jour, jamais modifié ensuite (pas de deuxième essai)
    match /dailyScores/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'day', 'month', 'first', 'ms', 'pts', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.month is string && request.resource.data.day.matches(request.resource.data.month + '-[0-9]{2}')
        && request.resource.data.first is int && request.resource.data.first >= 0 && request.resource.data.first <= 3
        && request.resource.data.pts == 10 + 10 * request.resource.data.first
        && request.resource.data.ms is number && request.resource.data.ms >= 5000
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 40;
      allow delete: if isAdmin();
    }
    // Tournois en réel : historique du créateur ; lisible aussi par les joueurs avec qui il l'a partagé
    match /otbTournaments/{id} {
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow create, update: if request.auth != null && request.resource.data.owner == request.auth.uid
        && id.matches(request.auth.uid + '_[0-9]+')
        && (resource == null || resource.data.owner == request.auth.uid)
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'name', 'date', 'sharedWith', 'json', 'updatedAt'])
        && request.resource.data.sharedWith is list && request.resource.data.sharedWith.size() <= 50
        && request.resource.data.json is string && request.resource.data.json.size() < 900000;
      allow delete: if (request.auth != null && resource.data.owner == request.auth.uid) || isAdmin();
    }
    // Clubs et écoles : le responsable gère son club ; un joueur peut seulement s'y ajouter ou s'en retirer lui-même
    match /clubs/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'code', 'owner', 'ownerName', 'members', 'names', 'createdAt'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if request.auth != null && changedOnly(['name', 'members', 'names']) && request.resource.data.members.size() <= 200 && (
        resource.data.owner == request.auth.uid
        || (changedOnly(['members', 'names'])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && ((!(request.auth.uid in resource.data.members) && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
            || request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))));
      allow delete: if (request.auth != null && resource.data.owner == request.auth.uid) || isAdmin();
    }
    // Pseudos uniques : chaque pseudo pointe vers un seul compte
    match /pseudos/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
    }
    // Invitations : visibles par l'expéditeur et le destinataire
    match /invites/{id} {
      allow read, delete: if (request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)) || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'fromElo', 'to', 'toName', 'toElo', 'tc', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'fromElo', 'to', 'toName', 'toElo', 'tc', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 24
        && request.resource.data.fromElo is number && request.resource.data.fromElo >= 100 && request.resource.data.fromElo <= 3200
        && request.resource.data.toElo is number && request.resource.data.toElo >= 100 && request.resource.data.toElo <= 3200
        && request.resource.data.tc in ['unlim', '7d', '3d', '1d', 'pm60', 'pm30', '10m', '5m', '2m', '1m']
        && request.resource.data.status == 'pending' && request.resource.data.createdAt is number;
      allow update: if false;
    }
    // Parties : lisibles et jouables seulement par leurs deux joueurs
    match /games/{id} {
      // les parties de tournoi se regardent par tous (en direct ou en différé) ; seuls les joueurs les jouent
      allow read: if (request.auth != null && (request.auth.uid in resource.data.players || resource.data.tournamentId is string)) || isAdmin();
      allow update: if request.auth != null && request.auth.uid in resource.data.players
        && changedOnly(['moves', 'lastMoveAt', 'seen', 'clock', 'status', 'result', 'reason', 'chat', 'takeback', 'takebackAnswer', 'drawOffer', 'drawAnswer'])
        && request.resource.data.players == resource.data.players
        && request.resource.data.white == resource.data.white
        && request.resource.data.black == resource.data.black
        && request.resource.data.get('tournamentId', null) == resource.data.get('tournamentId', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && validMoveUpdate();
      // une partie de tournoi peut être créée par n'importe quel membre du tournoi (ronde suivante)
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['players', 'white', 'black', 'whiteName', 'blackName', 'whiteElo', 'blackElo', 'tc', 'clock', 'moves', 'lastMoveAt', 'status', 'result', 'reason', 'seen', 'createdAt'])
        && request.resource.data.keys().hasOnly(['players', 'white', 'black', 'whiteName', 'blackName', 'whiteElo', 'blackElo', 'tc', 'clock', 'moves', 'lastMoveAt', 'status', 'result', 'reason', 'seen', 'createdAt', 'tournamentId', 'tournamentName', 'round', 'board', 'leg'])
        && request.resource.data.players is list && request.resource.data.players.size() == 2
        && request.resource.data.white is string && request.resource.data.black is string
        && request.resource.data.white != request.resource.data.black
        && request.resource.data.white in request.resource.data.players && request.resource.data.black in request.resource.data.players
        && request.resource.data.whiteName is string && request.resource.data.whiteName.size() <= 24
        && request.resource.data.blackName is string && request.resource.data.blackName.size() <= 24
        && request.resource.data.whiteElo is number && request.resource.data.whiteElo >= 100 && request.resource.data.whiteElo <= 3200
        && request.resource.data.blackElo is number && request.resource.data.blackElo >= 100 && request.resource.data.blackElo <= 3200
        && request.resource.data.tc in ['unlim', '7d', '3d', '1d', 'pm60', 'pm30', '10m', '5m', '2m', '1m']
        && request.resource.data.moves == [] && request.resource.data.status == 'active'
        && request.resource.data.result == null && request.resource.data.reason == null
        && request.resource.data.lastMoveAt is number && request.resource.data.createdAt is number
        && (request.resource.data.clock == null
          || (request.resource.data.clock is map
            && request.resource.data.clock.keys().hasOnly(['w', 'b'])
            && request.resource.data.clock.keys().hasAll(['w', 'b'])
            && request.resource.data.clock.w is number && request.resource.data.clock.w >= 0 && request.resource.data.clock.w <= 259200000
            && request.resource.data.clock.b is number && request.resource.data.clock.b >= 0 && request.resource.data.clock.b <= 259200000))
        && request.resource.data.seen is map
        && request.resource.data.seen.keys().hasOnly(request.resource.data.players)
        && (!('tournamentId' in request.resource.data)
          ? request.auth.uid in request.resource.data.players
          : (request.resource.data.tournamentId is string
            && request.auth.uid in get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.members
            && request.resource.data.white in get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.members
            && request.resource.data.black in get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.members));
      allow delete: if false;
    }
    // Tournois : visibles par les joueurs connectés ; créés par leur organisateur ; mis à jour par les inscrits
    match /tournaments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      // Un membre ne peut modifier que les données métier du tournoi ; le propriétaire
      // garde la gestion complète de son tournoi. Les autres champs restent immuables.
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.owner)
        || (request.auth != null && request.auth.uid in resource.data.members
          && changedOnly(['members', 'players', 'teams', 'names', 'elos', 'status', 'round', 'totalRounds', 'startedAt', 'pairings', 'scores', 'met']));
      allow delete: if (request.auth != null && resource.data.owner == request.auth.uid) || isAdmin();
    }
  }
}
